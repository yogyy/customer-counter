/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steam-be",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-18",
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moretti",
      "database_id": "012644a7-bd6f-4d54-8496-79de87848e9f",
      "migrations_dir": "drizzle",
      "migrations_table": "__drizzle_migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "2892d13a327c4979b854e496a84a25cd"
    }
  ],
  "vars": {
    "BETTER_AUTH_SECRET": "",
    "BETTER_AUTH_URL": "",
    "AUTH_GITHUB_ID": "",
    "AUTH_GITHUB_SECRET": ""
  }
}
